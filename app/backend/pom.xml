<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.pecdevelopers</groupId>
    <artifactId>pec-events-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>pec-events-backend</name>
    <description>Spring Boot REST API backend for the PEC Events PWA — event registration, payment verification, and role-based access management for Prathyusha Engineering College.</description>

    <url>https://api.events.pecdevelopers.com</url>
    <developers>
        <developer>
            <id>gideonjacob</id>
            <name>Gideon Jacob S</name>
            <email>gideonjacob.in@gmail.com</email>
            <organization>PEC Developers</organization>
            <organizationUrl>https://github.com/pec-developers</organizationUrl>
            <roles>
                <role>developer</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:git://github.com/pec-developers/pec-events-app.git</connection>
        <developerConnection>scm:git:ssh://github.com/pec-developers/pec-events-app.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/pec-developers/pec-events-app</url>
    </scm>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <java.version>25</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
